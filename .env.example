# JSON-RPC URL for your chain (e.g. local Hardhat: http://127.0.0.1:8545)
RPC_URL=

# Buyer wallet — deploys the contract, creates escrows, deposits, releases, and refunds.
BUYER_PRIVATE_KEY=

# Seller wallet — payout address for createEscrow / releaseFunds (derived from this key).
SELLER_PRIVATE_KEY=

# Deployed EscrowContract address (CLI deploy writes this automatically).
CONTRACT_ADDRESS=
